{
  "info": {
    "_postman_id": "m4-eshop-ddt-collection-23120228",
    "name": "EShop API - Data-Driven Testing (Member M4 - 23120228)",
    "description": "Postman Data-Driven Testing (DDT) collection demonstrating Collection Runner with external data file (postman/data_driven_coupons.json).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const studentId = pm.environment.get('studentId') || '23120228';",
          "pm.request.headers.upsert({ key: 'X-Student-Id', value: studentId });"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "DDT: Apply Coupon with Iteration Data",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function() {",
              "  const expectedStatus = pm.iterationData.get('expectedStatus');",
              "  const testCase = pm.iterationData.get('testCase');",
              "  const expectedDiscount = pm.iterationData.get('expectedDiscount');",
              "  const expectedFinal = pm.iterationData.get('expectedFinal');",
              "",
              "  pm.test(`[DDT] ${testCase} -> Status code is ${expectedStatus}`, function() {",
              "    pm.response.to.have.status(expectedStatus);",
              "  });",
              "",
              "  if (expectedStatus === 200) {",
              "    pm.test(`[DDT] ${testCase} -> Verify financial calculation`, function() {",
              "      const json = pm.response.json();",
              "      pm.expect(json.discount_amount).to.eql(expectedDiscount);",
              "      pm.expect(json.final_amount).to.eql(expectedFinal);",
              "    });",
              "  }",
              "})();"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{userToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"{{code}}\",\n  \"total_amount\": {{total_amount}},\n  \"user_id\": {{user_id}}\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/apply-coupon",
          "host": ["{{baseUrl}}"],
          "path": ["api", "apply-coupon"]
        }
      }
    }
  ]
}
